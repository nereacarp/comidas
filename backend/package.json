{
  "name": "comidas-backend",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --pool=threads --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.2.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.11.3",
    "fastify-plugin": "^5.0.1",
    "prisma": "^6.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "dotenv": "16.6.1",
    "knip": "^5.44.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "overrides": {
      "effect": "^3.20.0",
      "defu": "^6.1.5",
      "fast-uri": "^3.1.5",
      "bn.js": "^4.12.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
