{
  "name": "comidas-backoffice",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --pool=threads --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "lint": "eslint src",
    "knip": "knip"
  },
  "dependencies": {
    "@refinedev/core": "^4.56.0",
    "@refinedev/react-router": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "@eslint/js": "^9.19.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "knip": "^5.44.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "jsdom": "^26.0.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "qs": "^6.15.2"
    },
    "onlyBuiltDependencies": ["esbuild"]
  }
}
