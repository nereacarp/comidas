# Copia este archivo a .env y sustituye todos los valores de ejemplo.

# Dominio público con DNS apuntando al servidor. Caddy obtiene y renueva TLS.
DOMAIN=comidas.example.com

# Identidad y correo que se muestran en Privacidad y Condiciones. Son
# obligatorios para construir la imagen de producción.
LEGAL_OPERATOR="Nombre completo o razón social"
LEGAL_CONTACT=privacidad@comidas.example.com

# Contraseña exclusiva para PostgreSQL.
DB_PASSWORD=cambia-esta-contrasena

# En Neon, DATABASE_URL debe ser la conexión agrupada (-pooler) utilizada por
# la aplicación y DIRECT_URL la conexión directa reservada para migraciones.
# DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://usuario:clave@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secreto de al menos 32 caracteres. Ejemplo: openssl rand -hex 64
JWT_SECRET=cambia-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Orígenes web autorizados, separados por comas (sin barra final).
ALLOWED_ORIGINS=https://comidas.example.com,http://localhost:8080

# Clave de administración de al menos 32 caracteres. El backoffice solo se
# publica en 127.0.0.1:8080; accede mediante un túnel SSH.
ADMIN_SECRET=cambia-por-otro-secreto-aleatorio-de-al-menos-32-caracteres

# Opcional: credenciales nominales para saber quién realiza cada acción. Si se
# define, sustituye ADMIN_SECRET. Cada secreto debe tener al menos 32 caracteres.
# ADMIN_CREDENTIALS_JSON={"nerea":"secreto-aleatorio-de-al-menos-32-caracteres"}

# Ciclo de cuenta. Mantén el registro cerrado hasta configurar el correo.
PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
APP_URL=https://comidas.example.com

# Correo transaccional mediante Resend. Obligatorio si PUBLIC_REGISTRATION=true.
RESEND_API_KEY=
MAIL_FROM="Comidas <no-reply@comidas.example.com>"

# Opcional: importar recetas con Gemini.
GEMINI_API_KEY=
